      "to": 594,
      "type": "database"
    },
    {
      "participant": "link",
      "from": 210,
      "to": 560,
      "type": "cloud"
    },
    {
      "participant": "b_dll",
      "from": 246,
      "to": 346,
      "type": "backend"
    },
    {
      "participant": "b_tx",
      "from": 294,
      "to": 526,
      "type": "messagebus"
    }
  ]
}
